# Copy this file to .env and change all secrets.
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=ginnungagap
S3_SECRET_KEY=change-me-too

# Password of the first account "admin". Used only when the database has no account.
GINNUNGAGAP_ADMIN_PASSWORD=change-me-admin

# Optional. Garbage collection keeps the cache below this size, for example 200GiB.
GC_STORAGE_LIMIT=

# Optional. The host port of the web UI and the proxy.
GINNUNGAGAP_PORT=8080
